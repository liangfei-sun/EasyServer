# ===== EasyServer 全局配置 =====
# 复制此文件为 .env 并修改配置项
# cp .env.example .env

# ===== 基础配置 =====
# 数据持久化目录（绝对路径）
DATA_DIR=./data

# ===== 域名配置 =====
# 主域名（如 example.com）
DOMAIN=example.com

# 子域名前缀（可自定义）
SUBDOMAIN_NOTES=notes
SUBDOMAIN_BOOKS=books
SUBDOMAIN_FILES=files
SUBDOMAIN_MEDIA=media
SUBDOMAIN_JOPLIN=joplin
SUBDOMAIN_STATUS=status
SUBDOMAIN_PANEL=panel

# ===== 访问模式 =====
# 可选值: domain（域名反代）| ipv6_direct（IPv6直连）| hybrid（混合）
ACCESS_MODE=domain

# HTTPS 端口（域名模式下使用，运营商通常封锁443）
HTTPS_PORT=8443

# ===== SSL 证书 =====
# Let's Encrypt 邮箱
SSL_EMAIL=admin@example.com

# ===== DNS 服务商配置 =====
# 阿里云 AccessKey（用于 ddns-go 和 acme.sh）
ALI_KEY=
ALI_SECRET=

# ===== 各服务密码（请修改为强密码）=====
# 生成强密码: openssl rand -hex 16

# Joplin PostgreSQL 数据库密码
JOPLIN_DB_PASSWORD=change_me_joplin_db

# NoteDiscovery 登录密码
NOTEDISCOVERY_PASSWORD=change_me_notes

# NoteDiscovery 会话密钥（随机字符串）
NOTEDISCOVERY_SECRET_KEY=change_me_session_key

# ===== Cloudflare Tunnel（可选）=====
CF_TUNNEL_TOKEN=

# ===== 服务开关（yes/no）=====
ENABLE_NGINX=yes
ENABLE_NOTEDISCOVERY=yes
ENABLE_CALIBRE_WEB=yes
ENABLE_FILEBROWSER=yes
ENABLE_JELLYFIN=yes
ENABLE_JOPLIN=yes
ENABLE_UPTIME_KUMA=yes
ENABLE_DDNS_GO=yes
ENABLE_ACME=yes
ENABLE_CLOUDFLARE_TUNNEL=no
