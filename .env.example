# ===== EasyServer 全局配置 =====
# 复制此文件为 .env 并修改配置项
# cp .env.example .env
#
# ===== 新架构路径约定 =====
# Docker 部署模式下，以下路径由 entrypoint.sh 自动设置，通常无需手动修改：
#   PROJECT_ROOT → 项目文件目录（modules 等运行时文件），容器内挂载到 /easyserver_data
#   DATA_DIR     → 数据持久化目录，容器内挂载到 /data
# 宿主机开发模式下，请将 PROJECT_ROOT 改为实际项目路径（如 /home/user/easyserver）

# ===== 基础配置 =====
# 项目文件目录（modules 等运行时文件所在位置）
# Docker 部署：由 entrypoint 自动设置为 /easyserver_data
# 宿主机部署：填写项目源码绝对路径，如 /home/user/easyserver
PROJECT_ROOT=/easyserver_data

# 数据持久化目录
# Docker 部署：由 entrypoint 自动设置为 /data
# 宿主机部署：填写数据目录绝对路径，如 /home/user/easyserver/data
DATA_DIR=/data

# ===== 域名配置 =====
# 主域名（如 example.com）
DOMAIN=example.com

# 子域名前缀（可自定义）
SUBDOMAIN_NOTES=notes
SUBDOMAIN_BOOKS=books
SUBDOMAIN_FILES=files
SUBDOMAIN_MEDIA=media
SUBDOMAIN_JOPLIN=joplin
SUBDOMAIN_STATUS=status
SUBDOMAIN_PANEL=panel

# ===== 访问模式 =====
# 可选值: domain（域名反代）| cloudflare_tunnel（CF隧道）| ipv6_direct（IPv6直连）| hybrid（混合）
ACCESS_MODE=domain

# HTTPS 端口（域名模式下使用，运营商通常封锁443）
HTTPS_PORT=8443

# ===== SSL 证书 =====
# Let's Encrypt 邮箱
SSL_EMAIL=admin@example.com

# ===== DNS 服务商配置 =====
# 阿里云 AccessKey（用于 ddns-go 和 acme.sh）
ALI_KEY=
ALI_SECRET=

# ===== 各服务密码（请修改为强密码）=====
# 生成强密码: openssl rand -hex 16

# Joplin PostgreSQL 数据库密码
JOPLIN_DB_PASSWORD=change_me_joplin_db

# NoteDiscovery 登录密码
NOTEDISCOVERY_PASSWORD=change_me_notes

# NoteDiscovery 会话密钥（随机字符串）
NOTEDISCOVERY_SECRET_KEY=change_me_session_key

# ===== Nextcloud 私有云盘 =====
# 安装模块时由 Web 界面表单自动写入，无需手工填写
NEXTCLOUD_PORT=8888
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com

# ===== Cloudflare Tunnel（可选）=====
CF_TUNNEL_TOKEN=
