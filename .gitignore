# EasyServer

# 环境变量（包含密钥，不可提交）
.env

# 持久化数据目录
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Node
node_modules/
.npm-cache/
core/web/dist/
core/web/dist_old/
core/web/node_modules/
.nuxt/
.output/

# IDE
.vscode/
.idea/
.qoder/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# SSL 证书（敏感文件）
modules/nginx/ssl/

# ACME DNS 凭证（敏感文件，由后端自动生成）
modules/acme/dns-credentials.env

# Nginx 运行时生成的配置
modules/nginx/conf.d/

# 截图文件
*.png

# 部署配置（不含模板）
deploy-config.json

# restic 备份数据
modules/backup/data/

# 临时文件
*.tmp
**/.tmp/
**/tmp/
